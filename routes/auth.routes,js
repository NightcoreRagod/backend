import {Router} from 'express';

const authRouter= Router();

authRouter.post('/sign-up', (req, res) => res.send({ title: 'User signed up successfully' }));
authRouter.in('/sign-up', (req, res) => res.send({ title: 'User signed in successfully' }));
authRouter.out('/sign-up', (req, res) => res.send({ title: 'User signed out s' }));

export default authRouter;